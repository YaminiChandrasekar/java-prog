@WebServlet("/list-tickets")
public class ListTicketsServlet extends HttpServlet {

    // Escape database text before placing it in HTML.
    private String escape(String s) {
        if (s == null) return "";

        return s.replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;")
                .replace("'", "&#39;");
    }

    @Override
    protected void doGet(HttpServletRequest request,
                         HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/html;charset=UTF-8");

        try {
            List<Ticket> tickets =
                    new TicketDAO().getAllTickets();

            PrintWriter out = response.getWriter();
            String context = request.getContextPath();

            out.println("<!DOCTYPE html><html><head>");
            out.println("<meta charset='UTF-8'>");
            out.println("<title>All Tickets</title>");
            out.println("<link rel='stylesheet' href='"
                    + context + "/style.css'>");

            out.println("<style>");
            out.println("table{width:100%;border-collapse:collapse;"
                    + "background:white;margin-top:20px;}");
            out.println("th,td{border:1px solid #ddd;"
                    + "padding:9px;text-align:left;}");
            out.println("th{background:#2563eb;color:white;}");
            out.println(".actions form{margin:5px 0;}");
            out.println(".actions select,.actions button{width:auto;"
                    + "margin:3px;padding:7px;}");
            out.println(".delete{background:#dc2626;}");
            out.println("</style></head><body>");

            out.println("<div class='container' "
                    + "style='max-width:1200px'>");
            out.println("<h1>IT Help Desk Tickets</h1>");
            out.println("<a href='" + context
                    + "/index.html'>Create New Ticket</a>");

            out.println("<table><tr>");
            out.println("<th>ID</th><th>User</th><th>Email</th>");
            out.println("<th>Issue</th><th>Description</th>");
            out.println("<th>Priority</th><th>Status</th>");
            out.println("<th>Actions</th></tr>");

            for (Ticket t : tickets) {

                out.println("<tr>");
                out.println("<td>" + t.getTicketId() + "</td>");
                out.println("<td>" + escape(t.getUserName()) + "</td>");
                out.println("<td>" + escape(t.getEmail()) + "</td>");
                out.println("<td>" + escape(t.getIssueTitle()) + "</td>");
                out.println("<td>" + escape(t.getDescription()) + "</td>");
                out.println("<td>" + escape(t.getPriority()) + "</td>");
                out.println("<td>" + escape(t.getStatus()) + "</td>");
                out.println("<td class='actions'>");

                out.println("<form method='post' action='"
                        + context + "/update-ticket'>");

                out.println("<input type='hidden' name='ticketId' "
                        + "value='" + t.getTicketId() + "'>");

                out.println("<select name='status'>");

                String[] statuses = {
                    "Open", "In Progress", "Resolved", "Closed"
                };

                for (String status : statuses) {
                    out.println("<option value='" + status + "' "
                            + (status.equals(t.getStatus())
                            ? "selected" : "") + ">"
                            + status + "</option>");
                }

                out.println("</select>");
                out.println("<button type='submit'>Update</button>");
                out.println("</form>");

                out.println("<form method='post' action='"
                        + context + "/delete-ticket'>");

                out.println("<input type='hidden' name='ticketId' "
                        + "value='" + t.getTicketId() + "'>");

                out.println("<button class='delete' type='submit'>"
                        + "Delete</button>");

                out.println("</form>");
                out.println("</td></tr>");
            }

            out.println("</table></div></body></html>");

        } catch (SQLException e) {
            throw new ServletException("Unable to load tickets", e);
        }
    }
}


