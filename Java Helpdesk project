package com.helpdesk.dao;

import com.helpdesk.model.Ticket;
import com.helpdesk.util.DBConnection;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class TicketDAO {

    // CREATE: Insert a new ticket
    public boolean addTicket(Ticket t) throws SQLException {

        String sql = "INSERT INTO tickets "
                + "(user_name, email, issue_title, description, priority) "
                + "VALUES (?, ?, ?, ?, ?)";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, t.getUserName());
            ps.setString(2, t.getEmail());
            ps.setString(3, t.getIssueTitle());
            ps.setString(4, t.getDescription());
            ps.setString(5, t.getPriority());

            return ps.executeUpdate() > 0;
        }
    }

    // READ: Get all tickets
    public List<Ticket> getAllTickets() throws SQLException {

        List<Ticket> list = new ArrayList<>();

        String sql = "SELECT * FROM tickets ORDER BY ticket_id DESC";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {

                Ticket t = new Ticket();

                t.setTicketId(rs.getInt("ticket_id"));
                t.setUserName(rs.getString("user_name"));
                t.setEmail(rs.getString("email"));
                t.setIssueTitle(rs.getString("issue_title"));
                t.setDescription(rs.getString("description"));
                t.setPriority(rs.getString("priority"));
                t.setStatus(rs.getString("status"));

                list.add(t);
            }
        }

        return list;
    }

    // UPDATE: Change ticket status
    public boolean updateStatus(int id, String status)
            throws SQLException {

        String sql = "UPDATE tickets SET status = ? "
                + "WHERE ticket_id = ?";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, status);
            ps.setInt(2, id);

            return ps.executeUpdate() > 0;
        }
    }

    // DELETE: Remove a ticket
    public boolean deleteTicket(int id) throws SQLException {

        String sql = "DELETE FROM tickets WHERE ticket_id = ?";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, id);

            return ps.executeUpdate() > 0;
        }
    }
}



