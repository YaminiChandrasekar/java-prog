package com.helpdesk.servlet;

import com.helpdesk.dao.TicketDAO;
import com.helpdesk.model.Ticket;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.io.IOException;
import java.sql.SQLException;

@WebServlet("/create-ticket")
public class CreateTicketServlet extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request,
                          HttpServletResponse response)
            throws ServletException, IOException {

        request.setCharacterEncoding("UTF-8");

        Ticket ticket = new Ticket();

        ticket.setUserName(request.getParameter("userName"));
        ticket.setEmail(request.getParameter("email"));
        ticket.setIssueTitle(request.getParameter("issueTitle"));
        ticket.setDescription(request.getParameter("description"));

        String priority = request.getParameter("priority");

        if (!"Low".equals(priority)
                && !"Medium".equals(priority)
                && !"High".equals(priority)) {
            priority = "Medium";
        }

        ticket.setPriority(priority);

        try {
            TicketDAO dao = new TicketDAO();

            if (dao.addTicket(ticket)) {
                response.sendRedirect(
                        request.getContextPath() + "/list-tickets");
            } else {
                response.sendError(
                        HttpServletResponse.SC_INTERNAL_SERVER_ERROR,
                        "Ticket could not be created.");
            }

        } catch (SQLException e) {
            throw new ServletException("Database error", e);
        }
    }
}

